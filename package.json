{
  "name": "@timotholt/solid-tree",
  "version": "0.8.0",
  "description": "A small, themeable SolidJS tree-view component (expand/collapse with persistence, selection, icons, counts, dividers, per-node action slots).",
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "dist",
    "src"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "solid": "./src/index.tsx",
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./virtual": {
      "solid": "./src/virtual.tsx",
      "import": {
        "types": "./dist/virtual.d.ts",
        "default": "./dist/virtual.js"
      }
    },
    "./theme.css": "./src/theme.css"
  },
  "scripts": {
    "build": "vite build && tsc --emitDeclarationOnly --outDir dist",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "solid-js": "^1.6.0",
    "@tanstack/solid-virtual": "^3.0.0"
  },
  "peerDependenciesMeta": {
    "@tanstack/solid-virtual": { "optional": true }
  },
  "devDependencies": {
    "solid-js": "^1.9.11",
    "@tanstack/solid-virtual": "^3.13.0",
    "typescript": "^5.6.0",
    "vite": "^5.4.0",
    "vite-plugin-solid": "^2.11.0"
  }
}
