{
  "name": "@timotholt/solid-tree",
  "version": "0.16.0",
  "description": "A small, themeable SolidJS tree-view component (expand/collapse with persistence, selection, icons, counts, dividers, per-node action slots).",
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "dist",
    "src"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "solid": "./src/index.tsx",
      "node": {
        "types": "./dist/index.d.ts",
        "default": "./dist/server/index.js"
      },
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./virtual": {
      "solid": "./src/virtual.tsx",
      "node": {
        "types": "./dist/virtual.d.ts",
        "default": "./dist/server/virtual.js"
      },
      "import": {
        "types": "./dist/virtual.d.ts",
        "default": "./dist/virtual.js"
      }
    },
    "./database": {
      "solid": "./src/database.tsx",
      "node": {
        "types": "./dist/database.d.ts",
        "default": "./dist/server/database.js"
      },
      "import": {
        "types": "./dist/database.d.ts",
        "default": "./dist/database.js"
      }
    },
    "./supabase": {
      "solid": "./src/supabase.tsx",
      "node": {
        "types": "./dist/supabase.d.ts",
        "default": "./dist/server/supabase.js"
      },
      "import": {
        "types": "./dist/supabase.d.ts",
        "default": "./dist/supabase.js"
      }
    },
    "./testing": {
      "solid": "./src/testing.ts",
      "node": {
        "types": "./dist/testing.d.ts",
        "default": "./dist/server/testing.js"
      },
      "import": {
        "types": "./dist/testing.d.ts",
        "default": "./dist/testing.js"
      }
    },
    "./theme.css": "./src/theme.css"
  },
  "scripts": {
    "build": "vite build && vite build -c vite.config.ssr.ts && tsc --emitDeclarationOnly --outDir dist",
    "typecheck": "tsc -p tsconfig.check.json",
    "lint": "eslint .",
    "test": "vitest run --project unit --project dom --project browser",
    "test:unit": "vitest run --project unit",
    "test:dom": "vitest run --project dom",
    "test:browser": "vitest run --project browser",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage --project unit --project dom --project browser",
    "gate": "npm run typecheck && npm run lint && npm run coverage && npm run build && npm run test:package && npm run lint:package && npm run size",
    "prepare": "npm run build",
    "test:package": "vitest run --project package",
    "lint:package": "publint && attw --pack . --profile esm-only --exclude-entrypoints theme.css",
    "size": "size-limit",
    "bench": "vitest run --project bench --silent=false"
  },
  "peerDependencies": {
    "@supabase/supabase-js": "^2.45.0",
    "@tanstack/solid-query": "^5.30.0",
    "@tanstack/solid-virtual": "^3.13.32",
    "solid-js": "^1.9.16"
  },
  "peerDependenciesMeta": {
    "@tanstack/solid-virtual": {
      "optional": true
    },
    "@tanstack/solid-query": {
      "optional": true
    },
    "@supabase/supabase-js": {
      "optional": true
    }
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@size-limit/preset-small-lib": "^14.2.0",
    "@solidjs/testing-library": "^0.8.10",
    "@supabase/supabase-js": "^2.118.0",
    "@tanstack/solid-query": "^5.104.5",
    "@tanstack/solid-virtual": "^3.13.48",
    "@vitest/browser-playwright": "^5.0.5",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^10.13.0",
    "fast-check": "^4.10.2",
    "happy-dom": "^21.0.4",
    "playwright": "^1.64.1",
    "publint": "^0.3.25",
    "size-limit": "^14.2.0",
    "solid-js": "^1.9.17",
    "typescript": "~6.0.0",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.4",
    "vite-plugin-solid": "^2.11.14",
    "vitest": "^5.0.5"
  }
}
