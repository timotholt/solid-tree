{
  "name": "@timotholt/solid-tree",
  "version": "0.16.0",
  "description": "A small, themeable SolidJS tree-view component (expand/collapse with persistence, selection, icons, counts, dividers, per-node action slots).",
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "dist",
    "src"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "solid": "./src/index.tsx",
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./virtual": {
      "solid": "./src/virtual.tsx",
      "import": {
        "types": "./dist/virtual.d.ts",
        "default": "./dist/virtual.js"
      }
    },
    "./database": {
      "solid": "./src/database.tsx",
      "import": {
        "types": "./dist/database.d.ts",
        "default": "./dist/database.js"
      }
    },
    "./supabase": {
      "solid": "./src/supabase.tsx",
      "import": {
        "types": "./dist/supabase.d.ts",
        "default": "./dist/supabase.js"
      }
    },
    "./theme.css": "./src/theme.css"
  },
  "scripts": {
    "build": "vite build && tsc --emitDeclarationOnly --outDir dist",
    "typecheck": "tsc -p tsconfig.check.json",
    "lint": "eslint .",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:dom": "vitest run --project dom",
    "test:browser": "vitest run --project browser",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "gate": "npm run typecheck && npm run lint && npm run coverage && npm run build"
  },
  "peerDependencies": {
    "@supabase/supabase-js": "^2.0.0",
    "@tanstack/solid-query": "^5.0.0",
    "@tanstack/solid-virtual": "^3.0.0",
    "solid-js": "^1.6.0"
  },
  "peerDependenciesMeta": {
    "@tanstack/solid-virtual": {
      "optional": true
    },
    "@tanstack/solid-query": {
      "optional": true
    },
    "@supabase/supabase-js": {
      "optional": true
    }
  },
  "devDependencies": {
    "@solidjs/testing-library": "^0.8.10",
    "@supabase/supabase-js": "^2.45.0",
    "@tanstack/solid-query": "^5.101.0",
    "@tanstack/solid-virtual": "^3.13.0",
    "@vitest/browser-playwright": "^5.0.5",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^10.13.0",
    "fast-check": "^4.10.2",
    "happy-dom": "^21.0.4",
    "playwright": "^1.64.1",
    "solid-js": "^1.9.17",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.4",
    "vite-plugin-solid": "^2.11.14",
    "vitest": "^5.0.5"
  }
}
