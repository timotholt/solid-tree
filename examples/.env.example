# Copy to ".env" for the <SupabaseTree> demo (/?supabase).
#   cp .env.example .env
# Values from your Supabase dashboard → Settings → API. anon key is public/safe.
# The two test users are the ones `supabase/npm run setup` creates.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=paste-anon-public-key-here

VITE_TEST_A_EMAIL=scratch+a@example.com
VITE_TEST_A_PASS=scratch-pass-A1!
VITE_TEST_B_EMAIL=scratch+b@example.com
VITE_TEST_B_PASS=scratch-pass-B1!
