# Copy this file to ".env" (same folder) and fill in the values below.
#   cp .env.example .env
# Then:  npm install  &&  npm run setup  &&  npm run audit
#
# .env is gitignored — your secrets never leave your machine.
# Every value comes from your Supabase dashboard. Links are for project
# "hijohpdispprsxefeywp" — swap the ref if you use a different project.

# ── REQUIRED ──────────────────────────────────────────────────────────────────

# Project URL.  Dashboard → Settings → API → "Project URL"
SUPABASE_URL=https://hijohpdispprsxefeywp.supabase.co

# anon / public key — SAFE to expose, it's the browser key.
# Dashboard → Settings → API → "Project API keys" → anon public
SUPABASE_ANON_KEY=paste-anon-public-key-here

# Database connection string (needed once, to create the table + RPCs).
# Dashboard → Settings → Database → "Connection string" → URI tab → copy.
# It contains your DB password. Stays in this gitignored file only.
# Looks like: postgresql://postgres.[ref]:[PASSWORD]@aws-...pooler.supabase.com:5432/postgres
SUPABASE_DB_URL=postgresql://postgres:password@host:5432/postgres

# ── OPTIONAL (recommended — makes it fully one-command) ───────────────────────

# service_role key — SECRET, server-side only, NEVER ship to a browser.
# Dashboard → Settings → API → "Project API keys" → service_role (click reveal).
# If set, `npm run setup` auto-creates two CONFIRMED test users, so you can SKIP
# the "turn off email confirmation" dashboard step. If you leave this blank,
# turn OFF Auth → Providers → Email → "Confirm email" instead.
SUPABASE_SERVICE_ROLE_KEY=

# Test users the audit signs in as (defaults are fine).
TEST_A_EMAIL=scratch+a@example.com
TEST_A_PASS=scratch-pass-A1!
TEST_B_EMAIL=scratch+b@example.com
TEST_B_PASS=scratch-pass-B1!

# How many scratch rows to seed (2000 makes virtualization obvious in the demo).
SEED_ROWS=2000
